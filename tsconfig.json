{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": { "@shared/*": ["./shared/*"] },
    "types": ["vite/client", "vite-plugin-pwa/client", "@testing-library/jest-dom", "node"]
  },
  "include": ["shared", "apps", "vite.apps.ts", "vite.*.config.ts", "vitest.config.ts", "vitest.rules.config.ts", "playwright.config.ts", "playwright.emu.config.ts", "e2e", "e2e-flow", "rules-test"]
}
