# Copia este archivo como .env.local y completa los valores de tu app web de Firebase
# (Configuración del proyecto > General > Tus apps > Configuración del SDK).
# Son identificadores públicos; la protección real está en firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Pon "true" para usar los emuladores locales (npm run emulators) en vez de la nube.
VITE_USE_EMULATORS=false

# Proveedor de teselas (opcional). OpenStreetMap solo es apto para bajo volumen:
# https://operations.osmfoundation.org/policies/tiles/
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>
